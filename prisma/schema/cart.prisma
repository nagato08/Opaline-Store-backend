// ---------------------------------------------------------------------------
// Panier et tunnel de commande
// ---------------------------------------------------------------------------

enum CartStatus {
  ACTIVE
  ABANDONED
  CONVERTED
  EXPIRED
}

model Cart {
  id     String     @id @default(cuid())
  /// Jeton opaque stocké en cookie pour le panier invité, fusionné à la connexion.
  token  String     @unique
  status CartStatus @default(ACTIVE)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  email  String?

  currencyCode String   @db.Char(3)
  currency     Currency @relation(fields: [currencyCode], references: [code])
  locale       Locale   @default(FR)

  shippingAddressId String?
  shippingAddress   Address? @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  /// Adresses saisies sans compte, avant création de la commande.
  guestShipping     Json?
  guestBilling      Json?

  /// Mode unique, pour un panier qui part en une seule fois — le cas courant.
  shippingMethodId String?
  shippingMethod   ShippingMethod? @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  deliverySlotId   String?
  deliverySlot     DeliverySlot?   @relation(fields: [deliverySlotId], references: [id], onDelete: SetNull)

  /// Un mode par groupe physique, quand le panier doit partir en plusieurs
  /// colis. Vide tant qu'un seul transporteur suffit : `shippingMethodId`
  /// reste alors la source, et rien ne change pour les paniers existants.
  shipments CartShipment[]

  /// Codes saisis par le client ; le montant réel est recalculé à chaque lecture.
  couponCodes   String[]
  giftCardCodes String[]

  /// Totaux recalculés à chaque modification, uniquement pour l'affichage rapide.
  subtotalCents Int @default(0)
  discountCents Int @default(0)
  shippingCents Int @default(0)
  taxCents      Int @default(0)
  totalCents    Int @default(0)

  customerNote String?
  ip           String?
  userAgent    String?

  abandonedAt         DateTime?
  abandonedMailSentAt DateTime?
  expiresAt           DateTime?
  convertedOrderId    String?   @unique
  convertedOrder      Order?    @relation(fields: [convertedOrderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items        CartItem[]
  reservations StockReservation[]

  @@index([userId, status])
  @@index([status, updatedAt])
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Decimal @db.Decimal(12, 3)

  /// Prix vu par le client au moment de l'ajout : sert à détecter et signaler
  /// un changement de tarif avant le paiement.
  unitPriceCents Int
  addedAt        DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// Personnalisation (gravure, message, choix de créneau...).
  customization Json?

  @@unique([cartId, variantId])
  @@index([variantId])
}

/// Mode de livraison retenu pour un groupe d'articles du panier.
///
/// Un meuble hors gabarit et une denrée réfrigérée n'ont aucun transporteur
/// commun : la commande part alors en deux colis, chacun avec son mode, son
/// créneau et son tarif. Le groupe est désigné par sa contrainte physique, pas
/// par une liste d'articles — la répartition se déduit des lignes et ne peut
/// donc pas se désynchroniser du panier.
model CartShipment {
  id     String @id @default(cuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  /// COLD_CHAIN, OVERSIZED ou STANDARD.
  constraint String

  methodId String
  method   ShippingMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)
  slotId   String?
  slot     DeliverySlot?  @relation(fields: [slotId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  /// Un seul mode par groupe : choisir deux fois remplace, jamais n'ajoute.
  @@unique([cartId, constraint])
}
