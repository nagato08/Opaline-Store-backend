// ---------------------------------------------------------------------------
// Commandes, paiements, factures
// Tout est figé (snapshot) : modifier un produit ne doit jamais modifier
// une commande passée.
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  AUTHORIZED
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
  SHIPPED
  DELIVERED
  RETURNED
}

model Order {
  id     String @id @default(cuid())
  /// Numéro lisible communiqué au client, distinct de l'identifiant technique.
  number String @unique

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  email  String
  phone  String?

  status            OrderStatus       @default(PENDING)
  paymentStatus     PaymentStatus     @default(UNPAID)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)

  currencyCode String   @db.Char(3)
  currency     Currency @relation(fields: [currencyCode], references: [code])
  /// Taux appliqué au moment de la commande, pour la comptabilité.
  exchangeRate Decimal  @default(1) @db.Decimal(18, 8)
  locale       Locale   @default(FR)

  /// Régime d'affichage retenu (TTC en UE, HT aux US) : sans ça, une facture
  /// archivée devient illisible si le réglage boutique change.
  pricesIncludeTax Boolean @default(true)

  subtotalCents Int @default(0)
  discountCents Int @default(0)
  shippingCents Int @default(0)
  taxCents      Int @default(0)
  ecoTaxCents   Int @default(0)
  totalCents    Int @default(0)
  paidCents     Int @default(0)
  refundedCents Int @default(0)

  vatNumber   String?
  isTaxExempt Boolean @default(false)
  /// Incoterm pour l'export hors UE : DDP (droits payés) ou DAP (à la charge du client).
  incoterm    String?

  customerNote String?
  adminNote    String?
  cancelReason String?
  ip           String?
  userAgent    String?
  /// Origine du trafic à la commande (utm_source, campagne, affilié).
  attribution  Json?

  placedAt    DateTime?
  confirmedAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items                OrderItem[]
  addresses            OrderAddress[]
  discounts            OrderDiscount[]
  taxLines             OrderTaxLine[]
  statusHistory        OrderStatusHistory[]
  payments             Payment[]
  refunds              Refund[]
  invoices             Invoice[]
  shipments            Shipment[]
  returnRequests       ReturnRequest[]
  reservations         StockReservation[]
  promotionRedemptions PromotionRedemption[]
  giftCardTransactions GiftCardTransaction[]
  downloadGrants       DownloadGrant[]
  loyaltyTransactions  LoyaltyTransaction[]
  cart                 Cart?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([email])
}

/// Copie figée des adresses : l'adresse du carnet peut changer ensuite.
model OrderAddress {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type        AddressType
  firstName   String
  lastName    String
  company     String?
  line1       String
  line2       String?
  postalCode  String
  city        String
  region      String?
  countryCode String      @db.Char(2)
  country     Country     @relation(fields: [countryCode], references: [code])
  phone       String?
  notes       String?

  @@unique([orderId, type])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Références conservées à titre indicatif : elles peuvent devenir nulles
  /// si le produit est supprimé, les champs figés ci-dessous font foi.
  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  sku         String
  name        String
  variantName String?
  imageUrl    String?

  quantity       Decimal @db.Decimal(12, 3)
  unitPriceCents Int
  discountCents  Int     @default(0)
  taxRatePercent Decimal @default(0) @db.Decimal(6, 3)
  taxCents       Int     @default(0)
  ecoTaxCents    Int     @default(0)
  totalCents     Int

  weightGrams      Int?
  requiresShipping Boolean  @default(true)
  isDigital        Boolean  @default(false)
  /// Lots livrés : indispensable pour un rappel produit sur l'alimentaire.
  lotNumbers       String[]
  customization    Json?

  refundedQuantity  Decimal @default(0) @db.Decimal(12, 3)
  fulfilledQuantity Decimal @default(0) @db.Decimal(12, 3)

  serialNumbers  SerialNumber[]
  shipmentItems  ShipmentItem[]
  returnItems    ReturnItem[]
  downloadGrants DownloadGrant[]
  reviews        Review[]

  @@index([orderId])
  @@index([variantId])
}

enum DiscountScope {
  ITEM
  CART
  SHIPPING
}

/// Remise appliquée, figée avec son libellé.
model OrderDiscount {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  promotionId String?
  promotion   Promotion?    @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  code        String?
  label       String
  scope       DiscountScope @default(CART)
  amountCents Int

  @@index([orderId])
}

/// Ventilation de la taxe par juridiction, nécessaire pour la déclaration OSS
/// et pour la sales tax américaine.
model OrderTaxLine {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name         String
  jurisdiction String?
  ratePercent  Decimal @db.Decimal(6, 3)
  taxableCents Int
  amountCents  Int
  isCompound   Boolean @default(false)

  @@index([orderId])
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  reason     String?
  actorId    String?
  actor      User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
}

enum PaymentProvider {
  MANUAL
  STRIPE
  PAYPAL
  BANK_TRANSFER
  CASH_ON_DELIVERY
}

enum PaymentState {
  PENDING
  REQUIRES_ACTION
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  EXPIRED
}

/// Une tentative de paiement. La vérité vient des webhooks du prestataire,
/// jamais du retour navigateur.
model Payment {
  id                String          @id @default(cuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          PaymentProvider
  /// Identifiant côté prestataire (PaymentIntent Stripe, ordre PayPal...).
  providerPaymentId String?
  method            String?
  state             PaymentState    @default(PENDING)

  amountCents  Int
  currencyCode String @db.Char(3)

  authorizedAt   DateTime?
  capturedAt     DateTime?
  failedAt       DateTime?
  failureCode    String?
  failureMessage String?

  /// Empreinte carte affichable et données antifraude renvoyées par le PSP.
  last4       String?
  cardBrand   String?
  riskScore   Int?
  rawResponse Json?

  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  refunds Refund[]

  @@unique([provider, providerPaymentId])
  @@index([orderId, state])
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Refund {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  amountCents      Int
  reason           String?
  status           RefundStatus @default(PENDING)
  providerRefundId String?
  /// Remboursement enregistré sans mouvement chez le PSP (geste commercial, avoir).
  isManual         Boolean      @default(false)

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  processedAt DateTime?
  createdAt   DateTime  @default(now())

  returnRequest ReturnRequest?

  @@index([orderId])
}

enum InvoiceType {
  INVOICE
  CREDIT_NOTE
}

/// Facture ou avoir, numérotation séquentielle continue exigée par la loi.
model Invoice {
  id      String      @id @default(cuid())
  orderId String
  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  number  String      @unique
  type    InvoiceType @default(INVOICE)

  totalCents   Int
  taxCents     Int
  currencyCode String @db.Char(3)

  pdfUrl   String?
  issuedAt DateTime @default(now())

  @@index([orderId])
}

/// Droit de téléchargement accordé après paiement d'un produit digital.
model DownloadGrant {
  id           String       @id @default(cuid())
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId  String
  orderItem    OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  assetId      String
  asset        DigitalAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tokenHash    String       @unique
  downloads    Int          @default(0)
  maxDownloads Int          @default(5)
  expiresAt    DateTime?
  createdAt    DateTime     @default(now())

  @@index([orderId])
}
