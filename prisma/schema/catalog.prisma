// ---------------------------------------------------------------------------
// Catalogue : produits, variantes, options, catégories, collections, médias
// ---------------------------------------------------------------------------

enum ProductType {
  PHYSICAL
  DIGITAL
  SERVICE
  BUNDLE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Brand {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  logoId    String?
  logo      Media?   @relation(fields: [logoId], references: [id], onDelete: SetNull)
  website   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations BrandTranslation[]
  products     Product[]
}

model BrandTranslation {
  id          String  @id @default(cuid())
  brandId     String
  brand       Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  locale      Locale
  name        String
  description String?

  @@unique([brandId, locale])
}

model Category {
  id         String     @id @default(cuid())
  parentId   String?
  parent     Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Category[] @relation("CategoryTree")
  /// Chemin matérialisé (`/meubles/salon`) pour requêter un sous-arbre sans récursion.
  path       String     @default("/")
  depth      Int        @default(0)
  position   Int        @default(0)
  imageId    String?
  image      Media?     @relation(fields: [imageId], references: [id], onDelete: SetNull)
  isActive   Boolean    @default(true)
  showInMenu Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  translations CategoryTranslation[]
  products     ProductCategory[]

  @@index([parentId, position])
  @@index([path])
}

model CategoryTranslation {
  id             String   @id @default(cuid())
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale         Locale
  name           String
  slug           String
  description    String?
  seoTitle       String?
  seoDescription String?

  @@unique([categoryId, locale])
  @@unique([locale, slug])
}

model Product {
  id     String        @id @default(cuid())
  type   ProductType   @default(PHYSICAL)
  status ProductStatus @default(DRAFT)

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  taxClassId String?
  taxClass   TaxClass? @relation(fields: [taxClassId], references: [id], onDelete: SetNull)

  /// Faux pour les produits digitaux et les services : pas de frais ni d'adresse de livraison.
  requiresShipping Boolean @default(true)
  /// Denrée périssable : impose lots + DLC et bride les zones de livraison.
  isPerishable     Boolean @default(false)
  /// Impose la saisie d'un numéro de série à l'expédition (électronique, high-tech).
  requiresSerial   Boolean @default(false)

  /// Conformité et transport international.
  hsCode          String?
  countryOfOrigin String? @db.Char(2)
  /// Éco-participation DEEE / mobilier, affichée séparément du prix (obligatoire en France).
  ecoTaxCents     Int     @default(0)
  warrantyMonths  Int?
  energyLabel     String?
  dangerousGoods  String?

  isFeatured  Boolean   @default(false)
  publishedAt DateTime?
  ratingAvg   Decimal   @default(0) @db.Decimal(3, 2)
  ratingCount Int       @default(0)
  soldCount   Int       @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  translations  ProductTranslation[]
  variants      Variant[]
  options       ProductOption[]
  categories    ProductCategory[]
  collections   CollectionProduct[]
  media         ProductMedia[]
  attributes    ProductAttributeValue[]
  foodDetail    FoodDetail?
  relationsFrom ProductRelation[]       @relation("ProductRelationSource")
  relationsTo   ProductRelation[]       @relation("ProductRelationTarget")
  bundleItems   BundleItem[]            @relation("BundleParent")
  reviews       Review[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  searchPins    SearchPin[]

  @@index([status, publishedAt])
  @@index([brandId])
  @@index([type, status])
}

model ProductTranslation {
  id               String  @id @default(cuid())
  productId        String
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale           Locale
  name             String
  slug             String
  shortDescription String?
  description      String?
  seoTitle         String?
  seoDescription   String?

  @@unique([productId, locale])
  @@unique([locale, slug])
  @@index([name])
}

model ProductCategory {
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  position   Int      @default(0)
  isPrimary  Boolean  @default(false)

  @@id([productId, categoryId])
  @@index([categoryId, position])
}

/// Type d'option (Couleur, Taille, Matière...).
model OptionType {
  id        String   @id @default(cuid())
  code      String   @unique
  position  Int      @default(0)
  /// Rendu attendu côté front : swatch couleur, pastille, liste déroulante.
  displayAs String   @default("dropdown")
  createdAt DateTime @default(now())

  translations   OptionTypeTranslation[]
  values         OptionValue[]
  productOptions ProductOption[]
}

model OptionTypeTranslation {
  id           String     @id @default(cuid())
  optionTypeId String
  optionType   OptionType @relation(fields: [optionTypeId], references: [id], onDelete: Cascade)
  locale       Locale
  name         String

  @@unique([optionTypeId, locale])
}

model OptionValue {
  id           String     @id @default(cuid())
  optionTypeId String
  optionType   OptionType @relation(fields: [optionTypeId], references: [id], onDelete: Cascade)
  code         String
  position     Int        @default(0)
  hexColor     String?
  imageId      String?
  image        Media?     @relation(fields: [imageId], references: [id], onDelete: SetNull)

  translations OptionValueTranslation[]
  variants     VariantOptionValue[]

  @@unique([optionTypeId, code])
}

model OptionValueTranslation {
  id            String      @id @default(cuid())
  optionValueId String
  optionValue   OptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)
  locale        Locale
  label         String

  @@unique([optionValueId, locale])
}

model ProductOption {
  id           String     @id @default(cuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionTypeId String
  optionType   OptionType @relation(fields: [optionTypeId], references: [id], onDelete: Cascade)
  position     Int        @default(0)

  @@unique([productId, optionTypeId])
}

/// Unité réellement vendue : c'est elle qui porte le SKU, le prix et le stock.
model Variant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String  @unique
  barcode   String?
  position  Int     @default(0)
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  /// Logistique. Le volume sert au calcul des frais pour les produits encombrants (meubles).
  weightGrams Int?
  lengthMm    Int?
  widthMm     Int?
  heightMm    Int?
  isOversized Boolean @default(false)

  /// Vente au poids/volume (alimentaire) : quantité décimale et pas d'unité entière.
  isSoldByMeasure Boolean  @default(false)
  measureUnit     String?
  stepQuantity    Decimal  @default(1) @db.Decimal(12, 3)
  minQuantity     Decimal  @default(1) @db.Decimal(12, 3)
  maxQuantity     Decimal?
  /// Contenu net et base de comparaison pour le prix à l'unité de mesure
  /// (« 4,50 € / kg »), obligatoire en UE sur les denrées préemballées.
  netContent      Decimal? @db.Decimal(12, 3)
  netContentUnit  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  optionValues        VariantOptionValue[]
  prices              Price[]
  inventoryItems      InventoryItem[]
  stockLots           StockLot[]
  stockMovements      StockMovement[]
  stockReservations   StockReservation[]
  serialNumbers       SerialNumber[]
  media               ProductMedia[]
  cartItems           CartItem[]
  orderItems          OrderItem[]
  wishlistItems       WishlistItem[]
  bundleComponents    BundleItem[]         @relation("BundleComponent")
  digitalAssets       DigitalAsset[]
  backInStockRequests BackInStockRequest[]

  @@index([productId, position])
}

model VariantOptionValue {
  variantId     String
  variant       Variant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValueId String
  optionValue   OptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
}

/// Composant d'un pack : un produit BUNDLE contient N variantes.
model BundleItem {
  id        String  @id @default(cuid())
  bundleId  String
  bundle    Product @relation("BundleParent", fields: [bundleId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant @relation("BundleComponent", fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Decimal @default(1) @db.Decimal(12, 3)
  position  Int     @default(0)

  @@unique([bundleId, variantId])
}

enum ProductRelationType {
  RELATED
  UPSELL
  CROSS_SELL
  ACCESSORY
  VARIANT_OF
}

model ProductRelation {
  id        String              @id @default(cuid())
  productId String
  product   Product             @relation("ProductRelationSource", fields: [productId], references: [id], onDelete: Cascade)
  relatedId String
  related   Product             @relation("ProductRelationTarget", fields: [relatedId], references: [id], onDelete: Cascade)
  type      ProductRelationType @default(RELATED)
  position  Int                 @default(0)

  @@unique([productId, relatedId, type])
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

model Media {
  id        String    @id @default(cuid())
  type      MediaType @default(IMAGE)
  url       String
  path      String?
  mimeType  String?
  sizeBytes Int?
  width     Int?
  height    Int?
  blurHash  String?
  folder    String?
  createdAt DateTime  @default(now())

  translations   MediaTranslation[]
  productMedia   ProductMedia[]
  brands         Brand[]
  categories     Category[]
  optionValues   OptionValue[]
  bannersDesktop Banner[]           @relation("BannerDesktop")
  bannersMobile  Banner[]           @relation("BannerMobile")
  reviewMedia    ReviewMedia[]
  collections    Collection[]
  pages          PageTranslation[]
  posts          PostTranslation[]

  @@index([folder])
}

model MediaTranslation {
  id      String  @id @default(cuid())
  mediaId String
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  locale  Locale
  alt     String?
  caption String?

  @@unique([mediaId, locale])
}

model ProductMedia {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Renseigné quand le média n'illustre qu'une variante précise (couleur).
  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  position  Int      @default(0)

  @@unique([productId, mediaId, variantId])
  @@index([productId, position])
}

enum AttributeValueType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  OPTION
}

/// Caractéristique technique filtrable (puissance, matière, dimension, indice énergétique).
model AttributeDefinition {
  id           String             @id @default(cuid())
  code         String             @unique
  valueType    AttributeValueType @default(TEXT)
  unit         String?
  isFilterable Boolean            @default(false)
  isComparable Boolean            @default(false)
  position     Int                @default(0)

  translations AttributeDefinitionTranslation[]
  values       ProductAttributeValue[]
}

model AttributeDefinitionTranslation {
  id          String              @id @default(cuid())
  attributeId String
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  locale      Locale
  name        String

  @@unique([attributeId, locale])
}

model ProductAttributeValue {
  id           String              @id @default(cuid())
  productId    String
  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId  String
  attribute    AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  locale       Locale?
  valueText    String?
  valueNumber  Decimal?            @db.Decimal(18, 4)
  valueBoolean Boolean?
  valueDate    DateTime?

  @@unique([productId, attributeId, locale])
  @@index([attributeId, valueNumber])
}

enum CollectionType {
  MANUAL
  AUTOMATIC
}

/// Regroupement marketing (« Soldes d'été », « Nouveautés »), manuel ou par règles.
model Collection {
  id        String         @id @default(cuid())
  code      String         @unique
  type      CollectionType @default(MANUAL)
  /// Règles d'appartenance quand `type = AUTOMATIC` (marque, catégorie, prix, tag...).
  rules     Json?
  imageId   String?
  image     Media?         @relation(fields: [imageId], references: [id], onDelete: SetNull)
  isActive  Boolean        @default(true)
  position  Int            @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  translations CollectionTranslation[]
  products     CollectionProduct[]
  campaigns    Campaign[]
}

model CollectionTranslation {
  id             String     @id @default(cuid())
  collectionId   String
  collection     Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  locale         Locale
  name           String
  slug           String
  description    String?
  seoTitle       String?
  seoDescription String?

  @@unique([collectionId, locale])
  @@unique([locale, slug])
}

model CollectionProduct {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  position     Int        @default(0)

  @@id([collectionId, productId])
}

/// Informations réglementaires obligatoires pour les denrées alimentaires (règlement INCO).
model FoodDetail {
  id                String   @id @default(cuid())
  productId         String   @unique
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Codes allergènes normalisés (GLUTEN, LACTOSE, NUTS...).
  allergens         String[]
  /// Valeurs nutritionnelles pour 100 g/ml.
  nutrition         Json?
  storageTempMin    Decimal? @db.Decimal(5, 2)
  storageTempMax    Decimal? @db.Decimal(5, 2)
  requiresColdChain Boolean  @default(false)
  shelfLifeDays     Int?
  originCountry     String?  @db.Char(2)
  alcoholDegree     Decimal? @db.Decimal(4, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  translations FoodDetailTranslation[]
}

model FoodDetailTranslation {
  id            String     @id @default(cuid())
  foodDetailId  String
  foodDetail    FoodDetail @relation(fields: [foodDetailId], references: [id], onDelete: Cascade)
  locale        Locale
  ingredients   String?
  usageAdvice   String?
  storageAdvice String?
  legalNotice   String?

  @@unique([foodDetailId, locale])
}

/// Fichier livré pour un produit digital.
model DigitalAsset {
  id           String   @id @default(cuid())
  variantId    String
  variant      Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  name         String
  storageKey   String
  sizeBytes    Int?
  version      String?
  maxDownloads Int      @default(5)
  validityDays Int?
  createdAt    DateTime @default(now())

  grants DownloadGrant[]
}

/// Journal des recherches : alimente les suggestions et surtout révèle les
/// requêtes sans résultat, qui sont autant de ventes manquées.
model SearchQuery {
  id          String   @id @default(cuid())
  term        String
  /// Terme normalisé (minuscules, sans accent) servant de clé d'agrégation.
  normalized  String
  locale      Locale
  resultCount Int      @default(0)
  userId      String?
  createdAt   DateTime @default(now())

  @@index([normalized])
  @@index([createdAt])
  @@index([resultCount])
}

/// Synonymes gérés depuis l'administration : « sofa » doit trouver « canapé ».
model SearchSynonym {
  id        String   @id @default(cuid())
  term      String
  synonyms  String[] @default([])
  locale    Locale   @default(FR)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([term, locale])
}

/// Mise en avant manuelle : épingler un produit en tête d'une requête donnée.
model SearchPin {
  id        String   @id @default(cuid())
  term      String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  position  Int      @default(0)
  locale    Locale   @default(FR)
  createdAt DateTime @default(now())

  @@unique([term, locale, productId])
}
