// ---------------------------------------------------------------------------
// Livraison, expéditions et retours
// ---------------------------------------------------------------------------

model Carrier {
  id                  String   @id @default(cuid())
  code                String   @unique
  name                String
  /// Gabarit d'URL de suivi, `{tracking}` remplacé à l'affichage.
  trackingUrlTemplate String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())

  methods   ShippingMethod[]
  shipments Shipment[]
}

model ShippingZone {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  /// Codes ISO des pays couverts ; `regions` restreint aux États/provinces.
  countryCodes String[]
  regions      String[]
  priority     Int      @default(0)
  isActive     Boolean  @default(true)

  methods ShippingMethod[]
}

enum ShippingRateType {
  FLAT
  BY_WEIGHT
  BY_PRICE
  BY_VOLUME
  FREE
  PICKUP
  CARRIER_API
}

model ShippingMethod {
  id        String           @id @default(cuid())
  zoneId    String
  zone      ShippingZone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  carrierId String?
  carrier   Carrier?         @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  code      String           @unique
  rateType  ShippingRateType @default(FLAT)

  taxClassId String?
  taxClass   TaxClass? @relation(fields: [taxClassId], references: [id], onDelete: SetNull)

  /// Livraison sur créneau : indispensable pour les meubles et le frais.
  requiresSlot      Boolean @default(false)
  supportsColdChain Boolean @default(false)
  supportsOversized Boolean @default(false)

  minDeliveryDays Int?
  maxDeliveryDays Int?
  maxWeightGrams  Int?
  freeAboveCents  Int?

  position Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations ShippingMethodTranslation[]
  rates        ShippingRate[]
  slots        DeliverySlot[]
  carts        Cart[]
  shipments    Shipment[]

  @@index([zoneId, position])
}

model ShippingMethodTranslation {
  id          String         @id @default(cuid())
  methodId    String
  method      ShippingMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)
  locale      Locale
  name        String
  description String?

  @@unique([methodId, locale])
}

/// Palier tarifaire : bornes sur le poids, le montant ou le volume selon `rateType`.
model ShippingRate {
  id           String         @id @default(cuid())
  methodId     String
  method       ShippingMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)
  currencyCode String         @db.Char(3)
  currency     Currency       @relation(fields: [currencyCode], references: [code])
  minValue     Decimal        @default(0) @db.Decimal(12, 3)
  maxValue     Decimal?       @db.Decimal(12, 3)
  priceCents   Int
  perUnitCents Int?

  @@index([methodId, minValue])
}

/// Créneau de livraison réservable, avec capacité.
model DeliverySlot {
  id        String         @id @default(cuid())
  methodId  String
  method    ShippingMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)
  date      DateTime       @db.Date
  startTime String
  endTime   String
  capacity  Int            @default(1)
  booked    Int            @default(0)
  isActive  Boolean        @default(true)

  carts     Cart[]
  shipments Shipment[]

  @@unique([methodId, date, startTime])
  @@index([date])
}

enum ShipmentStatus {
  PENDING
  READY
  SHIPPED
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

/// Une commande peut être expédiée en plusieurs colis.
model Shipment {
  id         String          @id @default(cuid())
  orderId    String
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrierId  String?
  carrier    Carrier?        @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  methodId   String?
  method     ShippingMethod? @relation(fields: [methodId], references: [id], onDelete: SetNull)
  locationId String?
  location   Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  slotId     String?
  slot       DeliverySlot?   @relation(fields: [slotId], references: [id], onDelete: SetNull)

  status         ShipmentStatus @default(PENDING)
  trackingNumber String?
  trackingUrl    String?
  labelUrl       String?
  weightGrams    Int?
  costCents      Int?

  shippedAt   DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items ShipmentItem[]

  @@index([orderId])
  @@index([trackingNumber])
}

model ShipmentItem {
  id          String    @id @default(cuid())
  shipmentId  String
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity    Decimal   @db.Decimal(12, 3)

  @@unique([shipmentId, orderItemId])
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  IN_TRANSIT
  RECEIVED
  COMPLETED
  CANCELLED
}

enum ReturnResolution {
  REFUND
  EXCHANGE
  STORE_CREDIT
  REPAIR
}

/// Demande de retour (droit de rétractation 14 jours en UE, SAV, produit défectueux).
model ReturnRequest {
  id              String           @id @default(cuid())
  number          String           @unique
  orderId         String
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  status          ReturnStatus     @default(REQUESTED)
  resolution      ReturnResolution @default(REFUND)
  reason          String?
  customerComment String?
  adminComment    String?

  refundId String? @unique
  refund   Refund? @relation(fields: [refundId], references: [id], onDelete: SetNull)

  labelUrl   String?
  approvedAt DateTime?
  receivedAt DateTime?
  closedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  items ReturnItem[]

  @@index([orderId])
  @@index([status, createdAt])
}

model ReturnItem {
  id            String        @id @default(cuid())
  returnId      String
  returnRequest ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId   String
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity      Decimal       @db.Decimal(12, 3)
  reason        String?
  condition     String?
  isRestocked   Boolean       @default(false)

  @@unique([returnId, orderItemId])
}
