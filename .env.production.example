# Configuration de production. Copier en .env.production et remplir.
# Ce fichier ne doit jamais être versionné.

NODE_ENV=production
PORT=3000

# --- Domaines ---------------------------------------------------------------
# Utilisés pour CORS et pour construire les liens des emails.
API_DOMAIN=api.opaline.tadjo.dev
APP_URL=https://api.opaline.tadjo.dev
STOREFRONT_URL=https://opaline.tadjo.dev
ADMIN_URL=https://admin.opaline.tadjo.dev

# --- Base de données --------------------------------------------------------
POSTGRES_USER=opaline
POSTGRES_PASSWORD=
POSTGRES_DB=opaline
# `postgres` et `redis` sont les noms des services dans le réseau interne.
DATABASE_URL=postgresql://opaline:MOT_DE_PASSE@postgres:5432/opaline?schema=public

REDIS_PASSWORD=
REDIS_URL=redis://:MOT_DE_PASSE@redis:6379

# --- Secrets ----------------------------------------------------------------
# 32 caractères minimum, sinon l'application refuse de démarrer.
# Générer avec : openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=30d

# --- Services externes ------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.exemple.fr/api/auth/google/callback

RESEND_API_KEY=
MAIL_FROM="Boutique <commandes@exemple.fr>"
MAIL_REPLY_TO=contact@exemple.fr

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=boutique

# --- Limitation de débit ----------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=120
